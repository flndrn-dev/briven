# IMPORTANT: studio source code (lib/constants/, pages/api/, docker-entrypoint.sh)
# reads SUPABASE_* env names directly. These are treated as an internal protocol
# inherited from the upstream supabase studio fork — DO NOT rename them to
# BRIVEN_* without sweeping every source reference, or the deployed container
# silently receives empty strings for storage/auth/anon keys and every related
# panel returns 500. User-facing rebranding (UI copy, DASHBOARD_USERNAME, etc.)
# is fine; the internal env-var protocol stays SUPABASE_*.
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
