# briven-core self-host — copy to `.env` and fill in.
# Generate secrets with `openssl rand -hex 32`.

# Domain you own. The compose creates routes for:
#   ${BRIVEN_DOMAIN}             — dashboard
#   api.${BRIVEN_DOMAIN}         — control plane
#   docs.${BRIVEN_DOMAIN}        — docs
#   realtime.${BRIVEN_DOMAIN}    — websocket service
BRIVEN_DOMAIN=briven.example.com

# Pin a release tag here (e.g. v0.5.0) when you don't want :latest.
BRIVEN_VERSION=latest

# Required secrets — at least 32 chars each.
BRIVEN_BETTER_AUTH_SECRET=__set_me__32_plus_chars__
BRIVEN_AUDIT_IP_PEPPER=__set_me__32_plus_chars__
BRIVEN_ENCRYPTION_KEY=__set_me__32_plus_chars__
BRIVEN_RUNTIME_SHARED_SECRET=__set_me__32_plus_chars__

# Postgres superuser — used by every service to talk to control + data
# planes, and by minio's root user. Make it strong.
BRIVEN_POSTGRES_PASSWORD=__set_me_strong__

# Magic-link email. Without this, magic-link emails print to the api
# container's stdout (useful for first-user bootstrap).
# BRIVEN_RESEND_API_KEY=re_...

# Optional: GitHub OAuth.
# BRIVEN_GITHUB_CLIENT_ID=...
# BRIVEN_GITHUB_CLIENT_SECRET=...

# Public open signups. Default `false` — invite-only. Flip to `true`
# when you want a fully public instance.
BRIVEN_OPEN_SIGNUPS=false
